{
  "name": "@z2net/bffi-loader",
  "version": "0.1.0",
  "description": "Bun-only runtime loader for bffi-rs native modules: typed APIs built from the canonical loader JSON.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DotBlood/bffi-rs.git",
    "directory": "packages/bffi-loader"
  },
  "bugs": {
    "url": "https://github.com/DotBlood/bffi-rs/issues",
    "email": "contact@z2net.com"
  },
  "author": {
    "name": "z2net",
    "email": "contact@z2net.com"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "bffi",
