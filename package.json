{
  "name": "bffi-rs",
  "version": "0.1.0",
  "private": true,
  "description": "Bun-only native binding framework (Rust)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DotBlood/bffi-rs.git"
  },
  "bugs": {
    "url": "https://github.com/DotBlood/bffi-rs/issues",
    "email": "contact@z2net.com"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "clippy": "cargo clippy --workspace -- -D warnings",
    "test": "cargo test --workspace",
    "check": "bun run lint && bun run typecheck && cargo check --workspace",
    "ci": "bun run lint && bun run typecheck && bun run fmt:check && bun run clippy && bun run test"
  },
  "devDependencies": {
    "lefthook": "latest",
    "oxlint": "latest",
    "typescript": "^7",
    "@types/bun": "latest"
  }
}
